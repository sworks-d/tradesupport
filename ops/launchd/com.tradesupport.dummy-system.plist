<?xml version="1.0" encoding="UTF-8"?>
<!-- DS 自動売買: 朝バッチ後 07:15 に MISATO 経由で自動売買 ON の機だけ fill。
     HALT ファイル / 自動売買期限 / 予算上限 などの安全装置を経由するため、
     普段（自動売買トグル OFF）は dry-run 相当でレポートだけ更新。
     B 修正(2026-06): --approve（全機強制 fill・auto トグル迂回の安全バグ）を
     --auto-only（approve=False・自動売買 ON の機だけ fill）に置換。コメント通りの挙動に統一。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradesupport.dummy-system</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>scripts/misato_dispatch.py</string>
    <string>--auto-only</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/shotaro/tradesupport</string>

  <!-- 07:15 = 朝バッチ完了想定の 15 分後 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/shotaro/.trading-agent/logs/dummy-system.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/shotaro/.trading-agent/logs/dummy-system.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
