<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradesupport.ds-report-pm</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>scripts/build_ds_integrated_report.py</string>
        <string>--slot</string>
        <string>PM</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/shotaro/tradesupport</string>

    <!-- 18:30 夕 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/shotaro/.trading-agent/logs/ds-report-pm.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/shotaro/.trading-agent/logs/ds-report-pm.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
