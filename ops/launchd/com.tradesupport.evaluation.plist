<?xml version="1.0" encoding="UTF-8"?>
<!-- 評価ジョブを毎日 7:30 に実行（朝バッチの後）。設置手順は docs/OPERATIONS_SCHEDULING.md -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradesupport.evaluation</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/a05/tradesupport/.venv/bin/python</string>
    <string>/Users/a05/tradesupport/scripts/run_evaluation.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/a05/tradesupport</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/a05/tradesupport/data/logs/evaluation.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/a05/tradesupport/data/logs/evaluation.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
