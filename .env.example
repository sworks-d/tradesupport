# Trading Agent 環境変数テンプレート（SYSTEM_DESIGN.md §6.1）
#
# 使い方:
#   cp .env.example .env
#   このファイルの値を実際のキー・パスワードに置き換える
#
# 注意: .env はコミット禁止（.gitignore 済み）。
#       下記の <...> プレースホルダのままでもバリデーションは通る（型は満たすため）が、
#       実際の LLM / moomoo 連携には本物の値が必要。

# === API キー（必須） ===
# Anthropic Console (console.anthropic.com) で発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# === オプション API キー（未取得なら空でよい） ===
NEWSAPI_KEY=
JQUANTS_REFRESH_TOKEN=
EDINET_API_KEY=

# === moomoo（必須: OpenD 接続・取引） ===
MOOMOO_OPEND_HOST=localhost
MOOMOO_OPEND_PORT=11111
MOOMOO_TRADING_PWD=<your-moomoo-trading-password>
MOOMOO_ACCOUNT_ID=<your-moomoo-account-id>

# === モード ===
# paper（ペーパー口座）/ live（実弾）。Phase 1 は paper 固定推奨。
TRADING_MODE=paper
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# === ペーパー運用の仮想残高（D-23 元本 ¥100,000）===
# paper モードで moomoo の実残高に上乗せする仮想入金（実弾化したら実入金して live に切替＝overlay 無効）。
PAPER_OVERLAY_CASH_JPY=100000

# === パス（~ はホームに展開される） ===
DB_PATH=~/.trading-agent/db.sqlite
LOG_DIR=~/.trading-agent/logs
DATA_DIR=~/.trading-agent/data

# === LLM（Ollama: Cold Path 用ローカル LLM） ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === 通知（オプション） ===
SLACK_WEBHOOK_URL=
MACOS_NOTIFICATION=true

# === 緊急停止 ===
# このファイルが存在すると全処理を停止する（touch で作成、rm で再開）
HALT_FILE=~/.trading-agent/HALT
